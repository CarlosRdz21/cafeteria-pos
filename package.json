{
  "name": "cafeteria-pos",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:local": "ng serve --host localhost --port 4200",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "lint": "eslint \"src/**/*.{ts,html}\" capacitor.config.ts",
    "lint:fix": "npm run lint -- --fix",
    "format:check": "prettier --check eslint.config.mjs package.json .prettierrc.json .vscode/extensions.json .vscode/settings.json docs/estandares-etapa-10.md",
    "format": "prettier --write eslint.config.mjs package.json .prettierrc.json .vscode/extensions.json .vscode/settings.json docs/estandares-etapa-10.md",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:ci && npm run build",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessNoGpu",
    "android:sync": "npx cap sync android",
    "android:build": "npm run build:prod && npm run android:sync",
    "android:open": "npx cap open android",
    "android:run": "npm run android:build && npx cap run android",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:cafeteria-pos": "node dist/cafeteria-pos/server/server.mjs"
  },
  "private": true,
  "overrides": {
    "qs": "6.16.0"
  },
  "dependencies": {
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.25",
    "@angular/compiler": "^19.2.25",
    "@angular/core": "^19.2.25",
    "@angular/forms": "^19.2.25",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^19.2.25",
    "@angular/platform-browser-dynamic": "^19.2.25",
    "@angular/platform-server": "^19.2.25",
    "@angular/router": "^19.2.25",
    "@angular/ssr": "19.2.27",
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "date-fns": "^4.1.0",
    "express": "^4.22.2",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.15",
    "@angular/cli": "^19.2.15",
    "@angular/compiler-cli": "^19.2.25",
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "9.39.5",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.19.130",
    "angular-eslint": "19.8.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "3.9.5",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.65.0"
  }
}
