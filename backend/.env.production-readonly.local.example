# Copiar como .env.production-readonly.local y completar únicamente en el equipo local.
# La cuenta debe tener privilegios SELECT/SHOW sobre una sola base productiva.
# Codificar en URL los caracteres especiales de usuario y contraseña.
DATABASE_URL="mysql://READONLY_USER:URL_ENCODED_PASSWORD@PRODUCTION_HOST:3306/PRODUCTION_DATABASE"

# Opcionales: permiten comprobar los endpoints públicos sin inferir dominios.
PRODUCTION_FRONTEND_URL="https://frontend.example.com"
PRODUCTION_BACKEND_URL="https://backend.example.com"
