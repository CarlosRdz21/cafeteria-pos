DATABASE_URL=mysql://usuario:contrasena@localhost:3306/cafeteria_pos
JWT_SECRET=reemplazar-por-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h
FRONTEND_ORIGINS=http://localhost:4200,https://ejemplo.com
SOCKET_ORIGINS=http://localhost:4200,https://ejemplo.com
NODE_ENV=development
PORT=3000
JSON_BODY_LIMIT=1mb
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Diagnóstico opcional. Mantener deshabilitado si no se utiliza.
# MySQL aislado para integracion. Mantener valores reales solo en .env.test.
TEST_DATABASE_URL=
PRODUCTION_DATABASE_URL=
ALLOW_DESTRUCTIVE_TESTS=false
TEST_BASE_URL=http://127.0.0.1:3001
TEST_ADMIN_USERNAME=
TEST_ADMIN_PASSWORD=

AUTH_DEBUG_TOKEN=
CLONE_READ_ONLY=false

# Mercado Pago es opcional y solo debe configurarse cuando se utilice.
MP_ACCESS_TOKEN=
MP_SUCCESS_URL=
MP_PENDING_URL=
MP_FAILURE_URL=
MP_AUTO_RETURN=approved
MP_POINT_TERMINAL_ID=
MP_POINT_TERMINAL_SERIAL=
MP_POINT_STORE_ID=
MP_POINT_POS_ID=
MP_POINT_PRINT_ON_TERMINAL=no_ticket
