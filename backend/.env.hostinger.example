PORT=3000
JWT_SECRET=replace_with_a_secure_secret
JWT_EXPIRES_IN=1d
FRONTEND_ORIGINS=https://usauario.com,https://www.usauario.com,capacitor://localhost,http://localhost
MP_ACCESS_TOKEN=xxxxxxxxx
MP_POINT_TERMINAL_ID=
MP_POINT_TERMINAL_SERIAL=xxxxx
MP_POINT_STORE_ID=
MP_POINT_POS_ID=
MP_POINT_PRINT_ON_TERMINAL=no_ticket

# Opcion recomendada para Prisma (usa esta):
# Si tu password tiene caracteres especiales (@, #, :, /, ?), codificalos en URL.
# Ejemplo de @ => %40
DATABASE_URL="mysql://USUARIO:NUEVA_CONTRASENA@SERVIDOR:3306/NOMBRE_BASE_DATOS"

# Opcional: variables separadas (compatibilidad para codigo legado)
DB_HOST="xxxxxxxx"
DB_PORT="3306"
DB_NAME="xxxxxx"
DB_USER="xxxxx"
DB_PASSWORD="xxx"
