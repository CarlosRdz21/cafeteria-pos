PORT=3000
NODE_ENV=production
JWT_SECRET=replace_with_a_secure_secret
JWT_EXPIRES_IN=1d
FRONTEND_ORIGINS=https://frontend.example.com,capacitor://localhost
SOCKET_ORIGINS=https://frontend.example.com,capacitor://localhost
JSON_BODY_LIMIT=10mb
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
MP_ACCESS_TOKEN=replace_with_the_mercado_pago_token
MP_POINT_TERMINAL_ID=
MP_POINT_TERMINAL_SERIAL=replace_with_terminal_serial_if_used
MP_POINT_STORE_ID=
MP_POINT_POS_ID=
MP_POINT_PRINT_ON_TERMINAL=no_ticket
MP_SUCCESS_URL=https://frontend.example.com/checkout/success
MP_PENDING_URL=https://frontend.example.com/checkout/pending
MP_FAILURE_URL=https://frontend.example.com/checkout/failure
MP_AUTO_RETURN=approved

# Opcion recomendada para Prisma (usa esta):
# Si tu password tiene caracteres especiales (@, #, :, /, ?), codificalos en URL.
# Ejemplo de @ => %40
DATABASE_URL="mysql://USUARIO:NUEVA_CONTRASENA@SERVIDOR:3306/NOMBRE_BASE_DATOS"
