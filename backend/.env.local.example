# Copiar como .env.test para usar los scripts locales protegidos.
# Nunca reutilizar usuarios, contraseñas ni hosts de producción.
NODE_ENV=test
PORT=3000

DATABASE_URL=mysql://USUARIO_LOCAL:CONTRASENA_LOCAL@localhost:3306/cafeteria_pos_test
TEST_DATABASE_URL=mysql://USUARIO_LOCAL:CONTRASENA_LOCAL@localhost:3306/cafeteria_pos_test
PRODUCTION_DATABASE_URL=mysql://NO_USAR:NO_USAR@produccion-inexistente:3306/cafeteria_pos
ALLOW_DESTRUCTIVE_TESTS=true

JWT_SECRET=CAMBIAR_POR_SECRETO_LOCAL_ALEATORIO_DE_32_CARACTERES
JWT_EXPIRES_IN=8h

FRONTEND_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
SOCKET_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
LOG_LEVEL=debug

# Integraciones externas deshabilitadas en local.
MP_ACCESS_TOKEN=
MP_POINT_TERMINAL_ID=
MP_POINT_TERMINAL_SERIAL=
MP_POINT_STORE_ID=
MP_POINT_POS_ID=
