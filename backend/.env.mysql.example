PORT=3000
JWT_SECRET="xxxx"
JWT_EXPIRES_IN="8h"
FRONTEND_ORIGINS="https://usuario.com,https://www.usuario.com,capacitor://localhost,http://localhost"

# Requerido por Prisma (MySQL):
# Si tu password tiene caracteres especiales (@, #, :, /, ?), codificalos en URL.
# Ejemplo: @ -> %40
DATABASE_URL="mysql://USUARIO:NUEVA_CONTRASENA@SERVIDOR:3306/NOMBRE_BASE_DATOS"

# Mercado Pago Checkout API
MP_ACCESS_TOKEN="xxxxxxxxxxxxxxxx"
# Mercado Pago Point / Terminal
# Usa el ID directo de la terminal o el serial para resolverlo automaticamente.
MP_POINT_TERMINAL_ID=""
MP_POINT_TERMINAL_SERIAL="xxxxxxx"
MP_POINT_STORE_ID=""
MP_POINT_POS_ID=""
MP_POINT_PRINT_ON_TERMINAL="no_ticket"
# Opcionales para redirecciones de checkout
MP_SUCCESS_URL="https://www.dulcearomacafeteria.com/checkout/success"
MP_PENDING_URL="https://www.dulcearomacafeteria.com/checkout/pending"
MP_FAILURE_URL="https://www.dulcearomacafeteria.com/checkout/failure"
MP_AUTO_RETURN="approved"

# Opcional (solo para compatibilidad con codigo legado en este repo):
DB_HOST="xxxx"
DB_PORT="3306"
DB_NAME="xxxxx"
DB_USER="xxxxxxxx"
DB_PASSWORD="xxxx"
